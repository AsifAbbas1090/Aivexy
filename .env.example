# ── Database ─────────────────────────────────────────────────────────────────
# Local dev
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/aivexy"
# Supabase (production) — use the "Session mode" pooler URL (port 5432)
# DATABASE_URL="postgresql://postgres.YOURPROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
# Newsletter welcome mail “from” (app/api/newsletter/subscribe/route.ts)
RESEND_FROM_EMAIL="Aivexy <newsletter@aivexy.com>"

# ── Images ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Analytics & Ads ───────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"
AD_SLOT_SIDEBAR=""
AD_SLOT_IN_ARTICLE=""
AD_SLOT_FOOTER=""

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_URL="https://aivexy.com"
